    "d2_verified": "data/d2_dataset.json",
    "d3_human_gold": "data/gold/d3_human_gold.json",
    "d1_train": "data/datasets/d1_annotator_train.json",
    "d2_train": "data/datasets/d2_verified_train.json",
    "taxonomy": "data/unified_intents.csv",
    "intent_nodes": "data/intent_kb.intent_nodes_27_05_2026.csv",
    "intent_edges": "data/intent_kb.intent_edges_28_05_2026.csv"
  },
  "splits": {
    "train": "data/splits/train.json",
    "val": "data/splits/val.json",
    "test": "data/splits/test.json",
    "meta": "data/splits/split_meta.json",
    "train_size": 989,
    "val_size": 188,
    "test_size": 225,
    "d3_excluded": 300,
    "total_pool": 1402
